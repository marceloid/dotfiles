# Configuração do Ghostty — Linux (Omarchy / Hyprland)
# Documentação oficial: https://ghostty.org/docs/config

# --- Tema Dinâmico (Omarchy) --------------------------------------------------
# Importa as cores do tema ativo gerenciado pelo Omarchy (`omarchy theme set`)
config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"

# --- Fonte --------------------------------------------------------------------
font-family = "JetBrainsMono Nerd Font"
font-style = Regular
font-size = 11

# --- Janela -------------------------------------------------------------------
window-theme = ghostty
window-padding-x = 14
window-padding-y = 14
window-padding-balance = true
confirm-close-surface = false
resize-overlay = never
gtk-toolbar-style = flat
# Transparência sutil, igual à config do macOS
background-opacity = 0.95

# --- Cursor -------------------------------------------------------------------
cursor-style = "block"
cursor-style-blink = false

# --- Scrollback ---------------------------------------------------------------
# Limite em bytes (1.000.000 bytes ≈ 10 mil linhas de ~100 caracteres)
scrollback-limit = 1000000
mouse-scroll-multiplier = 0.95

# --- Seleção / Clipboard ------------------------------------------------------
copy-on-select = false

# --- Integração de Shell & SSH ------------------------------------------------
# (todas as opções de shell integration devem ser passadas juntas)
shell-integration-features = no-cursor,ssh-env

# --- Otimização Wayland / Hyprland --------------------------------------------
# Correção para performance no Hyprland (https://github.com/ghostty-org/ghostty/discussions/3224)
async-backend = epoll

# --- Atalhos de Teclado -------------------------------------------------------
keybind = f11=toggle_fullscreen
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard

# Envia Shift+Enter e Alt+Shift+Enter como CSI-u para TUIs/Neovim/tmux
keybind = shift+enter=csi:13;2u
keybind = alt+shift+enter=csi:13;4u

# Redimensionamento de splits
keybind = super+control+shift+alt+arrow_down=resize_split:down,100
keybind = super+control+shift+alt+arrow_up=resize_split:up,100
keybind = super+control+shift+alt+arrow_left=resize_split:left,100
keybind = super+control+shift+alt+arrow_right=resize_split:right,100

# Navegação de abas (Alt+1..9 para não conflitar com os workspaces do Hyprland)
keybind = alt+1=goto_tab:1
keybind = alt+2=goto_tab:2
keybind = alt+3=goto_tab:3
keybind = alt+4=goto_tab:4
keybind = alt+5=goto_tab:5
keybind = alt+6=goto_tab:6
keybind = alt+7=goto_tab:7
keybind = alt+8=goto_tab:8
keybind = alt+9=goto_tab:9
